{
    "rl_model": "MaskableRecurrentPPO",
    "tuning_library": "Optuna",
    "learning_scheduler": "constant",
    "parameters": {
        "learning_rate": {
            "min": 0.00001,
            "max": 0.01
        },
        "gamma": {
            "min": 0.9,
            "max": 0.999
        },
        "batch_size": {"values": [64, 128, 256, 512, 1024]},
        "clip_range": {
            "min": 0.1,
            "max": 0.5
        },
        "clip_range_vf": {
            "min": 0.1,
            "max": 0.5
        },
        "activation_fn": {"values": ["ReLU", "tanh"]},
        "n_steps": {"values": [128, 256, 512, 1024, 2048]},
        "hidden_layers": {"values": [[64, 64], [128, 128], [256, 256],
                                    [64, 64, 64], [128, 128, 128], [256, 256, 256]]},
        "lstm_hidden_size": {"values": [64, 128, 256, 512]},
        "n_lstm_layers": {"values": [1, 2, 3]},
        "ent_coef": {
            "min": 0.00001,
            "max": 0.01
        },
        "total_steps": {"values": [512000]},
        "seed": {"values": [0, 1, 2]}
    }

}